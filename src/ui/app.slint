import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "imgpress";
    icon: @image-url("../../assets/icon.ico");
    width: 980px;
    height: 680px;

    in-out property <string> input-path;
    in-out property <string> output-path;
    in-out property <string> max-size-kb-text: "500";
    in-out property <int> output-format-index;
    in-out property <string> min-quality-text: "20";
    in-out property <string> max-quality-text: "95";
    in-out property <string> scale-step-percent-text: "85";
    in-out property <string> max-scales-text: "8";
    in-out property <bool> preserve-structure: true;
    in-out property <bool> skip-if-smaller: true;
    in-out property <bool> recursive: true;
    in-out property <bool> delete-source;
    in-out property <bool> write-log;
    in-out property <bool> running;
    in-out property <float> progress;
    in-out property <string> summary;
    in-out property <string> run-log;
    in-out property <bool> delete-prompt-visible;
    in-out property <string> delete-countdown-text;

    callback browse-input();
    callback browse-output();
    callback start();
    callback cancel();
    callback open-output();
    callback open-log-dir();
    callback confirm-delete-source();
    callback cancel-delete-source();

    background: #eef2f6;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            padding: 20px;
            spacing: 18px;
            vertical-stretch: 1;

            Rectangle {
                width: 350px;
                vertical-stretch: 1;
                background: white;
                border-color: #d8dee8;
                border-width: 1px;
                border-radius: 12px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 18px;

                    Text {
                        text: "任务设置";
                        color: #111827;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    VerticalLayout {
                        spacing: 8px;

                        Text { text: "源目录"; color: #334155; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { text <=> root.input-path; horizontal-stretch: 1; }
                            Button { text: "浏览"; clicked => { root.browse-input(); } }
                        }
                        Text {
                            text: "选择需要压缩的图片或 PDF 所在目录";
                            color: #94a3b8;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;

                        Text { text: "输出目录"; color: #334155; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { text <=> root.output-path; horizontal-stretch: 1; }
                            Button { text: "浏览"; clicked => { root.browse-output(); } }
                        }
                        Text {
                            text: "压缩后的文件会写入这里，不覆盖源文件";
                            color: #94a3b8;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "处理选项";
                            color: #111827;
                            font-size: 15px;
                            font-weight: 700;
                        }

                        CheckBox { text: "保留目录结构"; checked <=> root.preserve-structure; }
                        Text { text: "按源目录层级生成输出文件夹"; color: #94a3b8; font-size: 11px; }

                        CheckBox { text: "跳过小文件"; checked <=> root.skip-if-smaller; }
                        Text { text: "已小于目标大小的普通图片直接复制"; color: #94a3b8; font-size: 11px; }

                        CheckBox { text: "递归扫描子目录"; checked <=> root.recursive; }
                        Text { text: "包含所有子文件夹中的支持格式"; color: #94a3b8; font-size: 11px; }

                        CheckBox { text: "写入运行日志"; checked <=> root.write-log; }
                        Text { text: "保存处理摘要和失败文件列表"; color: #94a3b8; font-size: 11px; }

                        CheckBox { text: "全部成功后删除源文件"; checked <=> root.delete-source; }
                        Text { text: "危险操作：失败或取消时不会删除"; color: #b45309; font-size: 11px; }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 18px;

                Rectangle {
                    height: 238px;
                    background: white;
                    border-color: #d8dee8;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                text: "压缩参数";
                                color: #111827;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "设置目标大小、格式、质量与缩放回退";
                                color: #64748b;
                                font-size: 12px;
                            }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "目标大小"; color: #334155; font-weight: 700; vertical-alignment: center; width: 86px; }
                                LineEdit { text <=> root.max-size-kb-text; width: 72px; }
                                Text { text: "KB / 张"; color: #64748b; vertical-alignment: center; }
                                Text { text: "每张输出图尽量不超过该大小"; color: #94a3b8; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "输出格式"; color: #334155; font-weight: 700; vertical-alignment: center; width: 86px; }
                                ComboBox {
                                    current-index <=> root.output-format-index;
                                    model: ["JPEG", "WebP"];
                                    width: 104px;
                                }
                                Text { text: "JPEG 兼容性更好，WebP 通常体积更小"; color: #94a3b8; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "质量范围"; color: #334155; font-weight: 700; vertical-alignment: center; width: 86px; }
                                LineEdit { text <=> root.min-quality-text; width: 54px; }
                                Text { text: "到"; color: #64748b; vertical-alignment: center; }
                                LineEdit { text <=> root.max-quality-text; width: 54px; }
                                Text { text: "1-100，越高越清晰"; color: #94a3b8; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "缩放回退"; color: #334155; font-weight: 700; vertical-alignment: center; width: 86px; }
                                LineEdit { text <=> root.scale-step-percent-text; width: 54px; }
                                Text { text: "%"; color: #64748b; vertical-alignment: center; }
                                LineEdit { text <=> root.max-scales-text; width: 54px; }
                                Text { text: "轮"; color: #64748b; vertical-alignment: center; }
                                Text { text: "超限时按比例缩小分辨率"; color: #94a3b8; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }
                        }

                        Text {
                            text: "说明：优先在质量范围内二分压缩；仍超限时再按缩放回退缩小分辨率。";
                            color: #94a3b8;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: white;
                    border-color: #d8dee8;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                text: "运行状态";
                                color: #111827;
                                font-size: 18px;
                                font-weight: 700;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.summary;
                                color: #475569;
                                font-size: 12px;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "任务进度";
                                color: #64748b;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            ProgressIndicator {
                                progress: root.progress;
                                height: 12px;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #f8fafc;
                            border-radius: 8px;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "处理日志";
                                    color: #64748b;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.run-log == "" ? "等待开始任务。" : root.run-log;
                                    color: #334155;
                                    font-size: 12px;
                                    vertical-stretch: 1;
                                }

                                Rectangle { height: 1px; }
                            }
                        }

                        HorizontalLayout {
                            height: 36px;
                            spacing: 10px;

                            Button {
                                text: root.running ? "运行中..." : "开始压缩";
                                enabled: !root.running;
                                clicked => { root.start(); }
                            }

                            Button {
                                text: "取消";
                                enabled: root.running;
                                clicked => { root.cancel(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                text: "打开输出目录";
                                clicked => { root.open-output(); }
                            }

                            Button {
                                text: "打开日志目录";
                                clicked => { root.open-log-dir(); }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        visible: root.delete-prompt-visible;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #111827;
        opacity: 0.35;
    }

    Rectangle {
        visible: root.delete-prompt-visible;
        width: 430px;
        height: 190px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: white;
        border-color: #d8dee8;
        border-width: 1px;
        border-radius: 12px;

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            Text {
                text: "确认删除源文件？";
                color: #111827;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                text: "压缩已经完成。继续后将删除源文件；如果不操作，倒计时结束后默认确认删除。";
                color: #475569;
                font-size: 12px;
                wrap: word-wrap;
            }

            Text {
                text: root.delete-countdown-text;
                color: #b45309;
                font-size: 13px;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "取消删除";
                    clicked => { root.cancel-delete-source(); }
                }

                Button {
                    text: "确认删除";
                    clicked => { root.confirm-delete-source(); }
                }
            }
        }
    }
}
